{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda listens only while you search by voice."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda 只會在你使用語音搜尋時聆聽。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda turns what you say into a search. On iPhones that support it, this happens on the device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda 會將你說的話轉換為搜尋內容。在支援的 iPhone 上，此處理會直接在裝置上進行。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda saves lyric cards you choose to save to your photos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda 會將你選擇儲存的歌詞卡片加入照片圖庫。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda uses a photo you pick as your profile picture. It stays on this iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Koda 會使用你選取的照片作為個人檔案圖片。照片只會保留在這部 iPhone 上。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
