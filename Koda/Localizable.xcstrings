          }
        }
      }
    },
    "Autoplay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoplay"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動播放"
          }
        }
      }
    },
    "Autoplay Next Video": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoplay Next Video"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動播放下一部影片"
          }
        }
      }
    },
    "Autoplay keeps the music going with songs like the last one when the queue ends. Normalize Volume plays loud masters at a similar level to everything else. AutoMix blends songs like a DJ, lining up beats and skipping silence; Crossfade overlaps the end of one song with the start of the next. Both give skips a short fade. Skip Buttons jump back or ahead within the song from Now Playing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoplay keeps the music going with songs like the last one when the queue ends. Normalize Volume plays loud masters at a similar level to everything else. AutoMix blends songs like a DJ, lining up beats and skipping silence; Crossfade overlaps the end of one song with the start of the next. Both give skips a short fade. Skip Buttons jump back or ahead within the song from Now Playing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放佇列結束後，自動播放會接著播放與上一首相似的歌曲。音量平衡會降低較大聲歌曲的音量，讓各首歌曲聽起來音量接近。自動混音會像 DJ 一樣對齊節拍、略過靜音並混合歌曲；交叉淡入淡出則讓上一首的結尾與下一首的開頭重疊。兩者都會在切換歌曲時短暫淡入淡出。快轉與倒轉按鈕可在「正在播放」中跳至歌曲的前後片段。"
          }
        }
      }
    },
