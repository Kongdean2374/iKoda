    "Format values are declared by the selected source, not measured from a quality setting. Missing values are shown as unavailable. Koda does not label lossy audio as lossless.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Format values are declared by the selected source, not measured from a quality setting. Missing values are shown as unavailable. Koda does not label lossy audio as lossless."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格式數值來自目前選用音源的宣告，不是由品質設定推算的測量值。缺少的數值會顯示「無法取得」。Koda 不會將有損音訊標示為無損。"
          }
        }
      }
    },
    "Format values come from the selected source or its audio track. Bitrate is source-declared, not inferred from a quality setting. Missing values are unavailable; lossy audio is not labeled lossless.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Format values come from the selected source or its audio track. Bitrate is source-declared, not inferred from a quality setting. Missing values are unavailable; lossy audio is not labeled lossless."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格式數值來自目前選用的音源或音軌。位元率由來源宣告，不是由品質設定推算。缺少的數值會顯示「無法取得」，有損音訊不會標示為無損。"
          }
        }
      }
    },
