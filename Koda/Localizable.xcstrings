          "stringUnit": {
            "state": "translated",
            "value": "自動混音"
          }
        }
      }
    },
    "AutoMix blends songs like a DJ, lining up beats and skipping silence. Crossfade overlaps the end of one song with the start of the next.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoMix blends songs like a DJ, lining up beats and skipping silence. Crossfade overlaps the end of one song with the start of the next."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動混音會像 DJ 一樣對齊節拍並略過靜音，流暢銜接歌曲。交叉淡入淡出會讓上一首的結尾與下一首的開頭重疊播放。"
          }
        }
      }
    },
    "AutoMix is blending into %@": {
      "extractionState": "manual",
