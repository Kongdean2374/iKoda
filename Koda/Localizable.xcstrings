          }
        }
      }
    },
    "Automatic translation uses Apple's on-device languages. The system may ask to download a language first; installed languages work offline. Chinese lyrics use local Simplified-to-Traditional conversion. Available imported lines take priority.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic translation uses Apple's on-device languages. The system may ask to download a language first; installed languages work offline. Chinese lyrics use local Simplified-to-Traditional conversion. Available imported lines take priority."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動翻譯使用 Apple 裝置端語言模型。系統可能先要求下載語言，安裝後即可離線使用。中文歌詞會在裝置上進行簡轉繁；已有匯入譯文的行會優先使用匯入內容。"
          }
        }
      }
    },
    "Automatically Translate to Traditional Chinese": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically Translate to Traditional Chinese"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
