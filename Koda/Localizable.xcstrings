    "Lyrics found earlier are kept until Koda closes. This forgets them, so the next song you open asks the sources again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyrics found earlier are kept until Koda closes. This forgets them, so the next song you open asks the sources again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到的歌詞會保留至 Koda 關閉。此操作會清除這些暫存，讓下次開啟歌曲時重新查詢歌詞來源。"
          }
        }
      }
    },
