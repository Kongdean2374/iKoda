    "Keep a record of what you play in Koda on your Last.fm profile. Koda never sees your password: you approve it on Last.fm's own page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a record of what you play in Koda on your Last.fm profile. Koda never sees your password: you approve it on Last.fm's own page."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Last.fm 個人檔案中記錄你在 Koda 播放的歌曲。你會在 Last.fm 的網頁上授權，Koda 不會取得你的密碼。"
          }
        }
      }
    },
