          "stringUnit": {
            "state": "translated",
            "value": "將第二位歌手的歌詞顯示於右側。"
          }
        }
      }
    },
    "The song title, artist, album and duration in your URL template are sent to the server you choose. Koda does not send lyrics, account cookies or login tokens.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The song title, artist, album and duration in your URL template are sent to the server you choose. Koda does not send lyrics, account cookies or login tokens."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網址範本中的歌曲名稱、藝人、專輯與長度會傳送到你指定的伺服器。Koda 不會傳送歌詞、帳號 Cookie 或登入權杖。"
          }
        }
      }
    },
