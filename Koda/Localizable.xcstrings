    "Use UTF-8 LRC with the original timestamps. A translated-only LRC or an original/translation pair at the same timestamp is supported. A timestamp must be within half a second of its original line.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use UTF-8 LRC with the original timestamps. A translated-only LRC or an original/translation pair at the same timestamp is supported. A timestamp must be within half a second of its original line."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 UTF-8 編碼的 LRC，並保留原始時間戳記。支援純譯文 LRC，或原文與譯文共用相同時間戳記的雙語 LRC。與原始歌詞行的時間差需在半秒以內。"
          }
        }
      }
    },
    "Use {title}, {artist}, {album}, and {duration} in the path or query. Include at least {title} or {artist}. Duration is rounded seconds; missing values are empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {title}, {artist}, {album}, and {duration} in the path or query. Include at least {title} or {artist}. Duration is rounded seconds; missing values are empty."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在路徑或查詢參數中使用 {title}、{artist}、{album} 與 {duration}，至少須包含 {title} 或 {artist}。長度以四捨五入的秒數表示，沒有資料的欄位會留空。"
          }
        }
      }
    },
