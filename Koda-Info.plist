<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ivors.Koda</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>koda</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Koda uses the microphone only for voice search or when you choose to identify nearby music.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Koda turns what you say into a search. On iPhones that support it, this happens on the device.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Koda saves lyric cards you choose to save to your photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Koda uses a photo you pick as your profile picture. It stays on this iPhone.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>KodaCarPlayAppGroup</key>
	<string>$(KODA_CARPLAY_APP_GROUP)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
					<key>UISceneConfigurationName</key>
					<string>Koda CarPlay Audio</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
